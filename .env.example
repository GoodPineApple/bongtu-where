# Vercel: Project → Settings → Environment Variables
# 브라우저에 노출되는 값만 NEXT_PUBLIC_ 접두사 사용

# https://developers.kakao.com/ 앱 키 (JavaScript 키)
# 배포 도메인은 카카오 개발자 콘솔 앱 → 플랫폼 → Web 사이트 도메인에 등록
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# Supabase: Project Settings → API (앱·브라우저용)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# npm run import:stores 전용 (서버·로컬만, Git에 커밋하지 말 것)
# URL은 위와 동일 프로젝트면 NEXT_PUBLIC_SUPABASE_URL 과 같아도 됨
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
