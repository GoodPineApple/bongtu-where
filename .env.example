# Vercel: Project → Settings → Environment Variables (Production / Preview)
# 빌드에 포함되려면 이름이 반드시 VITE_ 로 시작해야 함.

# https://developers.kakao.com/ 앱 키 (JavaScript 키)
# 배포 도메인은 카카오 개발자 콘솔 앱 → 플랫폼 → Web 사이트 도메인에 등록
VITE_KAKAO_MAP_APP_KEY=

# Supabase: Project Settings → API
# Project URL / anon → 앱(Vite)용
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# npm run import:stores 만: 같은 프로젝트 URL은 위 VITE_SUPABASE_URL 을 그대로 씀(스크립트가 읽음).
# service_role 만 추가하면 됨. anon 키로는 stores RLS 때문에 대량 upsert 불가.
SUPABASE_SERVICE_ROLE_KEY=